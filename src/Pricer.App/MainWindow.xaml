<Window x:Class="Pricer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Pricer.App.ViewModels"
        xmlns:p="clr-namespace:Pricer.Presentation;assembly=Pricer.Presentation"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Pricer" Height="760" Width="1200" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type p:NumberField}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Value, StringFormat=G8, UpdateSourceTrigger=LostFocus}"/>
                <!-- Minimum and Maximum must stay before Value: bindings apply in order and Value is coerced. -->
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0"
                        Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type p:ChoiceField}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type p:BoolField}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="0,3"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type p:DateField}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding Value}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type p:ParameterForm}">
            <GroupBox Header="{Binding Title}" Margin="0,0,0,8" Padding="6">
                <ItemsControl ItemsSource="{Binding Fields}"/>
            </GroupBox>
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="6">
    <TabItem Header="Pricer">
    <Grid Margin="8" DataContext="{Binding Pricer}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Product type" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ProductKinds}" SelectedItem="{Binding ProductKind}"/>
                <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="2" Text="Engine" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableEngines}" SelectedItem="{Binding SelectedEngine}" Margin="0,4,0,0"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Forms}"/>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="PV" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding PvText}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding MarketLabel}" Foreground="Gray" VerticalAlignment="Center" Margin="24,0,0,0"/>
                <Button Content="Add to book" Command="{Binding AddToBookCommand}" VerticalAlignment="Center" Margin="24,0,0,0" Padding="10,2"/>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Greeks}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Measure" Binding="{Binding Measure}" Width="100"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N6}" Width="100"/>
                    <DataGridTextColumn Header="Std error" Binding="{Binding Error, StringFormat=N6}" Width="80"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="160"/>
                    <DataGridTextColumn Header="Convention" Binding="{Binding Convention}" Width="130"/>
                    <DataGridTextColumn Header="Bump (control)" Binding="{Binding BumpValue, StringFormat=N6}" Width="110"/>
                    <DataGridTextColumn Header="Control convention" Binding="{Binding BumpConvention}" Width="130"/>
                    <DataGridTextColumn Header="Gap" Binding="{Binding Gap, StringFormat=E2}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SameConvention}" Value="False">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="ToolTip" Value="{x:Static p:GreekRow.ConventionNote}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Note" Binding="{Binding GapNote}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Engines}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="220"/>
                    <DataGridTextColumn Header="PV" Binding="{Binding Pv, StringFormat=N6}" Width="110"/>
                    <DataGridTextColumn Header="Std error" Binding="{Binding Error, StringFormat=N6}" Width="90"/>
                    <DataGridTextColumn Header="Time (ms)" Binding="{Binding Milliseconds, StringFormat=N1}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <scott:WpfPlot x:Name="ProfilePlot" Grid.Row="3"/>

            <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="Gray"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="Firebrick"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
    </TabItem>

    <TabItem Header="Market">
    <Grid Margin="8" DataContext="{Binding Market}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Snapshot" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Captures}" SelectedItem="{Binding SelectedCapture}" Width="420">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Id, Mode=OneWay}"/> · <Run Text="{Binding Source, Mode=OneWay}"/> · <Run Text="{Binding AsOf, Mode=OneWay, StringFormat=dd/MM/yyyy}"/> · <Run Text="{Binding Underlyings, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Underlying" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Underlying" Width="100"/>
            <Button Content="Capture IBKR" Command="{Binding CaptureIbkrCommand}" Margin="16,0,0,0" Padding="10,2"/>
            <Button Content="Cancel" Command="{Binding CaptureIbkrCancelCommand}" Margin="6,0,0,0" Padding="10,2"/>
            <Button Content="Capture Yahoo" Command="{Binding CaptureYahooCommand}" Margin="6,0,0,0" Padding="10,2"/>
            <Button Content="Synthetic capture" Command="{Binding CaptureSyntheticCommand}" Margin="6,0,0,0" Padding="10,2"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Slices}" SelectedItem="{Binding SelectedSlice}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240" SelectionMode="Single" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry}" Width="100"/>
                <DataGridTextColumn Header="T" Binding="{Binding T, StringFormat=F3}" Width="60"/>
                <DataGridTextColumn Header="Forward" Binding="{Binding Forward, StringFormat=F2}" Width="90"/>
                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="60"/>
                <DataGridTextColumn Header="RMSE (vol pts)" Binding="{Binding RmseVolPoints, StringFormat=F2}" Width="100"/>
                <DataGridTextColumn Header="Butterfly" Binding="{Binding Butterfly}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Warnings}" Foreground="Firebrick" TextWrapping="Wrap"/>

        <scott:WpfPlot x:Name="SmilePlot" Grid.Row="2"/>

        <DockPanel Grid.Row="2" Grid.Column="2">
            <TextBlock x:Name="SurfaceCaption" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,4,0,0"/>
            <helix:HelixViewport3D x:Name="SurfaceView" ShowViewCube="False" ShowCoordinateSystem="True" Background="White">
                <helix:DefaultLights/>
                <ModelVisual3D x:Name="SurfaceModel"/>
            </helix:HelixViewport3D>
        </DockPanel>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="Gray" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
    </TabItem>

    <TabItem Header="Model Lab">
    <Grid Margin="8" DataContext="{Binding ModelLab}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.RowSpan="2">
            <TextBlock Text="{Binding MarketLabel}" Foreground="Gray" Margin="0,0,0,8"/>
            <ContentControl Content="{Binding HestonForm}"/>
            <ContentControl Content="{Binding LocalVolForm}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Calibrate Heston" Command="{Binding CalibrateCommand}" Padding="10,2"/>
                <Button Content="Compare models" Command="{Binding CompareCommand}" Margin="6,0,0,0" Padding="10,2"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Column="2" ItemsSource="{Binding Slices}" SelectedItem="{Binding SelectedSlice}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240" SelectionMode="Single" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry}" Width="100"/>
                <DataGridTextColumn Header="T" Binding="{Binding T, StringFormat=F3}" Width="60"/>
                <DataGridTextColumn Header="RMSE SVI (vol pts)" Binding="{Binding Svi, StringFormat=F2}" Width="130"/>
                <DataGridTextColumn Header="RMSE Heston" Binding="{Binding Heston, StringFormat=F2}" Width="100"/>
                <DataGridTextColumn Header="RMSE local vol" Binding="{Binding LocalVol, StringFormat=F2}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <scott:WpfPlot x:Name="ModelPlot" Grid.Row="1" Grid.Column="2"/>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="Gray" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
    </TabItem>

    <TabItem Header="Book">
    <Grid Margin="8" DataContext="{Binding Book}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Forms}"/>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Run book" Command="{Binding RunCommand}" Padding="10,2"/>
            <Button Content="Cancel" Command="{Binding RunCancelCommand}" Margin="6,0,0,0" Padding="10,2"/>
            <Button Content="Demo book" Command="{Binding DemoCommand}" Margin="16,0,0,0" Padding="10,2"/>
            <Button Content="Import IBKR" Command="{Binding ImportIbkrCommand}" Margin="6,0,0,0" Padding="10,2"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="6,0,0,0" Padding="10,2"/>
            <TextBlock Text="Group by" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}" Width="100"/>
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalContentAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Summary}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" MaxHeight="200" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding Key}" Width="130"/>
                <DataGridTextColumn Header="Trades" Binding="{Binding Trades}" Width="50"/>
                <DataGridTextColumn Header="Failures" Binding="{Binding Failed}" Width="50"/>
                <DataGridTextColumn Header="Model greeks" Binding="{Binding ModelGreekTrades}" Width="100"/>
                <DataGridTextColumn Header="PV" Binding="{Binding Pv, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Std error" Binding="{Binding StandardError, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Delta cash" Binding="{Binding CashDelta, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="Gamma cash 1 %" Binding="{Binding CashGamma, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="Vega" Binding="{Binding Vega, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Theta" Binding="{Binding Theta, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Rho" Binding="{Binding Rho, StringFormat=N2}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedPosition}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="90"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="120"/>
                <DataGridTextColumn Header="Underlying" Binding="{Binding Underlying}" Width="90"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N0}" Width="60"/>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="80"/>
                <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="150"/>
                <DataGridTextColumn Header="PV" Binding="{Binding Pv, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Std error" Binding="{Binding Error, StringFormat=N3}" Width="70"/>
                <DataGridTextColumn Header="Delta cash" Binding="{Binding CashDelta, StringFormat=N0}" Width="80"/>
                <DataGridTextColumn Header="Vega" Binding="{Binding Vega, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,6,0,0">
            <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" Maximum="1" Value="{Binding Progress}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MarketLabel}" Foreground="Gray" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Status}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
    </TabItem>

    <TabItem Header="Runs">
    <Grid Margin="8" DataContext="{Binding Runs}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Reference run" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Left}" Width="300">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock><Run Text="{Binding Id, Mode=OneWay}"/> · <Run Text="{Binding Label, Mode=OneWay}"/> · PV <Run Text="{Binding Pv, Mode=OneWay, StringFormat=N2}"/></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="compared with" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Right}" Width="300">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock><Run Text="{Binding Id, Mode=OneWay}"/> · <Run Text="{Binding Label, Mode=OneWay}"/> · PV <Run Text="{Binding Pv, Mode=OneWay, StringFormat=N2}"/></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Trades}" SelectedItem="{Binding SelectedTrade}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trade" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Reference PV" Binding="{Binding Left, StringFormat=N4}" Width="110"/>
                <DataGridTextColumn Header="Compared PV" Binding="{Binding Right, StringFormat=N4}" Width="110"/>
                <DataGridTextColumn Header="Gap" Binding="{Binding Change, StringFormat=N4}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Configuration">
                <ListBox ItemsSource="{Binding ConfigChanges}" BorderThickness="0"/>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Causes for this trade" Margin="0,8,0,0">
                <ListBox ItemsSource="{Binding Causes}" BorderThickness="0"/>
            </GroupBox>
        </Grid>
    </Grid>
    </TabItem>

    <TabItem Header="PnL Explain">
    <Grid Margin="8" DataContext="{Binding Pnl}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding From}" Width="280">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock><Run Text="{Binding Id, Mode=OneWay}"/> · <Run Text="{Binding Label, Mode=OneWay}"/> · PV <Run Text="{Binding Pv, Mode=OneWay, StringFormat=N2}"/></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="to" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding To}" Width="280">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock><Run Text="{Binding Id, Mode=OneWay}"/> · <Run Text="{Binding Label, Mode=OneWay}"/> · PV <Run Text="{Binding Pv, Mode=OneWay, StringFormat=N2}"/></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Explain" Command="{Binding ExplainCommand}" Margin="12,0,0,0" Padding="10,2"/>
            <Button Content="Cancel" Command="{Binding ExplainCancelCommand}" Margin="6,0,0,0" Padding="10,2"/>
            <TextBlock Text="Group by" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}" Width="100"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Warnings}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <scott:WpfPlot x:Name="PnlPlot" Grid.Row="3"/>

        <StackPanel Grid.Row="3" Grid.Column="2">
            <ContentControl Content="{Binding Form}"/>
            <DataGrid ItemsSource="{Binding Factors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Factor" Binding="{Binding Factor}" Width="90"/>
                    <DataGridTextColumn Header="Full reval" Binding="{Binding Waterfall, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Greeks" Binding="{Binding Greeks, StringFormat=N2}" Width="75"/>
                    <DataGridTextColumn Header="Gap" Binding="{Binding Gap, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <DataGrid Grid.Row="4" Grid.ColumnSpan="3" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" MaxHeight="130" Margin="0,8,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding Key}" Width="120"/>
                <DataGridTextColumn Header="PnL" Binding="{Binding Total, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Events" Binding="{Binding Events, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Spot" Binding="{Binding Spot, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Dividends" Binding="{Binding Dividends, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Vol level" Binding="{Binding VolLevel, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Vol shape" Binding="{Binding VolShape, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Rates" Binding="{Binding Rates, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Composition" Binding="{Binding Composition, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Residual" Binding="{Binding Residual, StringFormat=N2}" Width="65"/>
                <DataGridTextColumn Header="Greeks residual" Binding="{Binding GreekResidual, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid Grid.Row="5" Grid.ColumnSpan="3" ItemsSource="{Binding Trades}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="170">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trade" Binding="{Binding Key}" Width="120"/>
                <DataGridTextColumn Header="PnL" Binding="{Binding Total, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Events" Binding="{Binding Events, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Spot" Binding="{Binding Spot, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Dividends" Binding="{Binding Dividends, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Vol level" Binding="{Binding VolLevel, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Vol shape" Binding="{Binding VolShape, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Rates" Binding="{Binding Rates, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Composition" Binding="{Binding Composition, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Residual" Binding="{Binding Residual, StringFormat=N2}" Width="65"/>
                <DataGridTextColumn Header="Greeks residual" Binding="{Binding GreekResidual, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="Gray" Margin="0,6,0,0"/>
    </Grid>
    </TabItem>
    </TabControl>
</Window>
