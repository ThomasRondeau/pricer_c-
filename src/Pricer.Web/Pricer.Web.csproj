<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <ItemGroup>
    <ProjectReference Include="..\Pricer.Presentation\Pricer.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.22" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Monte Carlo and calibration are CPU-bound: AOT runs them several times faster than the interpreter. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- All formats are explicit (yyyy-MM-dd, invariant numbers): no ICU data to download. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Parameter forms and records rely on reflection (attributes, <Clone>$, polymorphic JSON): keep them whole. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Pricer.Core" />
    <TrimmerRootAssembly Include="Pricer.Market" />
    <TrimmerRootAssembly Include="Pricer.Instruments" />
    <TrimmerRootAssembly Include="Pricer.Models" />
    <TrimmerRootAssembly Include="Pricer.Engines" />
    <TrimmerRootAssembly Include="Pricer.Risk" />
    <TrimmerRootAssembly Include="Pricer.Book" />
    <TrimmerRootAssembly Include="Pricer.Presentation" />
    <!-- JSON builds immutable collections through factory methods found by reflection. -->
    <TrimmerRootAssembly Include="System.Collections.Immutable" />
  </ItemGroup>

</Project>
